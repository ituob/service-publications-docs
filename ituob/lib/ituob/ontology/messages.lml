  // Register patches (datasets changes) — the register-layer patch
  // objects, mirroring Ituob::Registers::Change and Identifier. The
  // per-action-type conditionals (ADD requires data, SUP carries
  // superseded_by, LIR requires reason, ...) live in the JSON Schema
  // datasets/schema-change.yaml, which `ituob dataset validate` gates.
  // Registers::Change keeps type as a coerced String at runtime; the
  // ontology declares the ActionType vocabulary (waived in the drift
  // guard).

  enum ActionType {
    member_fields {
      description String
    }
    ADD {
      description "Insert a new record (data required)"
    }
    SUP {
      description "Supersede: point at the replacing record via superseded_by"
    }
    REP {
      description "Replace the record in full (data required)"
    }
    LIR {
      description "Last-issue repetition: entries repeated unchanged from the previous edition; no membership change"
    }
    MOD {
      description "Modify fields (merge_strategy replace_fields or replace_full)"
    }
    DEL {
      description "Irreversible hard delete, no payload"
    }
    SEED {
      description "Initial publication batch (array of rows, seed issue only)"
    }
  }

  class Identifier {
    attribute code, String
    attribute query, Hash
  }

  class RegisterChange {
    attribute type, ActionType
    attribute register_id, String
    attribute identifier, Identifier { cardinality 1 }
    attribute recommendation, String
    attribute data, HashOrList
    attribute ob_issue_no, Integer
    attribute date_active, String
    attribute date_requested, String
    attribute reference, String
    attribute description, Hash
    attribute superseded_by, Hash
    attribute reason, Hash
    attribute merge_strategy, String
    mapping yaml {
      map "register", to: "register_id"
    }
  }

  // Projection fields decided by PM, pending the design note.
  // Ordering belongs to the provider: items and history follow replay;
  // lapsed/deleted keys are sorted. Only clean projections are rendered.
  class ProjectionProvenance {
    attribute register_id, String { cardinality 1 }
    attribute as_of_issue, Integer { cardinality 1 }
    attribute seed_issue, Integer { cardinality 1 }
    attribute last_change_issue, Integer { cardinality 0..1 }
  }

  class KeyHistoryEntry {
    attribute key, String { cardinality 1 }
    attribute type, ActionType { cardinality 1 }
    attribute ob_issue_no, Integer { cardinality 1 }
    attribute identifier, Identifier { cardinality 1 }
  }

  class RegisterEdition {
    attribute metadata, RegisterLocale { cardinality 0..1 }
    attribute provenance, ProjectionProvenance { cardinality 1 }
    attribute items, Entry { cardinality 0..n }
    attribute source_contexts, F32SeedContext { cardinality 0..n }
    attribute lapsed_keys, String { cardinality 0..n }
    attribute deleted_keys, String { cardinality 0..n }
    attribute key_history, KeyHistoryEntry { cardinality 0..n }
  }

  // One localized term of a register's dataset metadata (column headers,
  // labels); key names the term and each language carries its text.
  class LocaleLabel {
    attribute key, String { cardinality 1 }
    attribute en, String
    attribute fr, String
    attribute es, String
    attribute zh, String
    attribute ru, String
    attribute ar, String
  }

  // The per-language title and terms of a register's dataset, as read
  // from its metadata.yaml. Not versioned by OB issue.
  class RegisterLocale {
    attribute title, MultilingualString { cardinality 0..1 }
    attribute locale, LocaleLabel { cardinality 0..n }
  }

  // One key's touched-change history as of an issue. membership is one of
  // active, lapsed, deleted or absent (touched but not currently listed).
  class RegisterKeyHistory {
    attribute provenance, ProjectionProvenance { cardinality 1 }
    attribute key, String { cardinality 1 }
    attribute membership, String { cardinality 1 }
    attribute entries, KeyHistoryEntry { cardinality 0..n }
  }

  class RegisterActions {
    attribute provenance, ProjectionProvenance { cardinality 1 }
    attribute changes, RegisterChange { cardinality 0..n }
  }

  // PDF publication manifest (pdf/manifest.json). status is one of
  // candidate or itu-adopted; see docs/pdf/manifest.adoc.
  class PublicationManifestEntry {
    attribute standard, String { cardinality 1 }
    attribute recommendation, String { cardinality 1 }
    attribute title, String { cardinality 1 }
    attribute edition_year, Integer { cardinality 1 }
    attribute language, String { cardinality 1 }
    attribute as_of_issue, Integer { cardinality 1 }
    attribute sha256, String { cardinality 1 }
    attribute status, String { cardinality 1 }
    attribute register_slugs, String { cardinality 0..n }
    attribute path, String { cardinality 1 }
  }

  class PublicationManifest {
    attribute publications, PublicationManifestEntry { cardinality 0..n }
  }

  // Published dataset snapshots. Explicit types preserve the stored wire shapes.

  class PublicationText {
    attribute en, String
    attribute fr, String
    attribute es, String
  }

  class PublicationE180EntryToneDesc {
    attribute en, String
    attribute fr, String
    attribute es, String
    attribute notes, PublicationText
  }

  class PublicationE180Entry {
    attribute _class, String
    attribute country_or_area, PublicationText
    attribute tone_desc, PublicationE180EntryToneDesc
    attribute frequency_in_hz, String
    attribute cadence_in_s, PublicationText
    attribute tone_type, String
    attribute notes, PublicationText
  }

  class PublicationMultilingualText {
    attribute en, String
    attribute fr, String
    attribute es, String
    attribute ru, String
    attribute zh, String
    attribute ar, String
  }

  class PublicationE212AEntry {
    attribute _class, String
    attribute code, String
    attribute country_or_area, PublicationMultilingualText
    attribute note, PublicationMultilingualText
  }

  class PublicationE212AMccMncEntry {
    attribute _class, String
    attribute mcc_mnc, String
    attribute network, String
    attribute status, String
    attribute former_name, String
  }

  class PublicationE212Entry {
    attribute _class, String
    attribute mcc_mnc_codes, String
    attribute country_or_area, PublicationMultilingualText
    attribute networks, String
    attribute note, PublicationMultilingualText
  }

  class PublicationE212EtEntry {
    attribute _class, String
    attribute country_or_area, PublicationMultilingualText
    attribute country_type, String
    attribute mcc_mnc, String
    attribute msin_range, String
    attribute operator_network, String
  }

  class PublicationE212OthersEntry {
    attribute _class, String
    attribute mcc_mnc_codes, String
    attribute applicant, String
    attribute purpose, PublicationMultilingualText
    attribute temporary_assignment_to, String
  }

  class PublicationE212SharedEntry {
    attribute _class, String
    attribute mcc_mnc_codes, String
    attribute networks, String
    attribute former_name, String
  }

  class PublicationF1Entry {
    attribute _class, String
    attribute code, String
    attribute field, String
    attribute message, PublicationText
    attribute field_desc, PublicationText
  }

  class PublicationF68Entry {
    attribute _class, String
    attribute number_block, String
    attribute allocated_to, PublicationText
    attribute telex_code, String
    attribute notes, PublicationText
    attribute integrated_numbering_plan, Boolean
  }

  class PublicationF68A1Entry {
    attribute _class, String
    attribute tnic_code, String
    attribute telegram_network_codes, String
    attribute country, PublicationText
    attribute number_block, String
    attribute allocated_to, PublicationText
  }

  class PublicationF68A2Entry {
    attribute _class, String
    attribute ob_number, Integer
    attribute telex_code, String
    attribute geographic_area, PublicationText
    attribute number_block, String
    attribute allocated_to, PublicationText
  }

  class PublicationPp21Entry {
    attribute _class, String
    attribute number, Integer
    attribute geographic_area, PublicationText
  }

  class PublicationSr1EntryGeographicArea {
    attribute fr, String
    attribute en, String
    attribute es, String
  }

  class PublicationSr1EntryRestrictionsNoCollectCalls {
    attribute mobile, Boolean
    attribute payphone, Boolean
    attribute audiotex, Boolean
    attribute incoming, Boolean
    attribute outgoing, Boolean
    attribute virtual, Boolean
  }

  class PublicationSr1EntryRestrictions {
    attribute telex_not_provided, Boolean
    attribute telegram_not_provided, Boolean
    attribute no_collect_calls, PublicationSr1EntryRestrictionsNoCollectCalls
    attribute no_messenger_dispatch, Boolean
  }

  class PublicationSr1EntryNotes {
    attribute en, String
    attribute es, String
    attribute fr, String
  }

  class PublicationSr1Entry {
    attribute _class, String
    attribute name, String
    attribute geographic_area, PublicationSr1EntryGeographicArea
    attribute restrictions, PublicationSr1EntryRestrictions
    attribute notes, PublicationSr1EntryNotes
  }

  class PublicationRr251EntryGroupsAmateurCriteriaValuesRange {
    attribute from, String
    attribute to, String
    attribute cardinality, String
  }

  class PublicationRr251EntryGroupsAmateurCriteriaValues {
    attribute segment_type, String
    attribute value, String
    attribute range, PublicationRr251EntryGroupsAmateurCriteriaValuesRange
  }

  class PublicationRr251EntryGroupsAmateurCriteria {
    attribute segment_type, String
    attribute key, String
    attribute value, String
    attribute values, PublicationRr251EntryGroupsAmateurCriteriaValues { cardinality 0..n }
    attribute range, PublicationRr251EntryGroupsAmateurCriteriaValuesRange
    attribute codelist, String
  }

  class PublicationRr251EntryGroupsAmateur {
    attribute regex, String
    attribute criteria, PublicationRr251EntryGroupsAmateurCriteria { cardinality 0..n }
    attribute name, String
  }

  class PublicationRr251EntryGroupsExperimentalCriteria {
    attribute segment_type, String
    attribute key, String
    attribute value, String
    attribute range, PublicationRr251EntryGroupsAmateurCriteriaValuesRange
    attribute codelist, String
  }

  class PublicationRr251EntryGroupsExperimental {
    attribute regex, String
    attribute criteria, PublicationRr251EntryGroupsExperimentalCriteria { cardinality 0..n }
    attribute name, String
  }

  class PublicationRr251EntryGroupsExperimential {
    attribute regex, String
  }

  class PublicationRr251EntryGroups {
    attribute amateur, PublicationRr251EntryGroupsAmateur { cardinality 0..n }
    attribute experimental, PublicationRr251EntryGroupsExperimental { cardinality 0..n }
    attribute experimential, PublicationRr251EntryGroupsExperimential { cardinality 0..n }
  }

  class PublicationRr251EntryCodelistsListCodeValue {
    attribute from, String
    attribute to, String
  }

  class PublicationRr251EntryCodelistsList {
    attribute name, String
    attribute code, String
  }

  class PublicationRr251EntryCodelists {
    attribute name, String
    attribute list, PublicationRr251EntryCodelistsList { cardinality 0..n }
  }

  class PublicationRr251Entry {
    attribute _class, String
    attribute groups, PublicationRr251EntryGroups
    attribute country_or_area, String
    attribute codelists, PublicationRr251EntryCodelists { cardinality 0..n }
    attribute notes, String { cardinality 0..n }
  }

  class PublicationT35Entry {
    attribute _class, String
    attribute code_bit, String
    attribute country_or_area, PublicationText
    attribute notes, PublicationText
  }

  class PublicationT35BEntryAssignmentAuthority {
    attribute organization, String
    attribute terminal_type, String { cardinality 0..n }
    attribute contact_name, String
    attribute department, String
    attribute address, String
    attribute telephone, String
    attribute fax, String
    attribute email, String
    attribute related_links, String { cardinality 0..n }
    attribute last_updated, String
  }

  class PublicationT35BEntry {
    attribute _class, String
    attribute country, String
    attribute administration_name, String
    attribute manufactures_htv, Boolean
    attribute last_updated, String
    attribute assignment_authority, PublicationT35BEntryAssignmentAuthority { cardinality 0..n }
    attribute note, String
  }

  class PublicationX121AEntry {
    attribute _class, String
    attribute code, String
    attribute zone, String
    attribute country_or_area, PublicationText
    attribute reserved, Boolean
    attribute spare, Boolean
  }

  class PublicationRr251CountryDataGroupsAmateur {
    attribute regex, String
    attribute description, String
    attribute criteria, PublicationRr251EntryGroupsAmateurCriteria { cardinality 0..n }
    attribute name, String
  }

  class PublicationRr251CountryDataGroupsExperimental {
    attribute regex, String
    attribute description, String
    attribute criteria, PublicationRr251EntryGroupsExperimentalCriteria { cardinality 0..n }
    attribute name, String
  }

  class PublicationRr251CountryDataGroups {
    attribute amateur, PublicationRr251CountryDataGroupsAmateur { cardinality 0..n }
    attribute experimental, PublicationRr251CountryDataGroupsExperimental { cardinality 0..n }
    attribute experimential, PublicationRr251EntryGroupsExperimential { cardinality 0..n }
  }

  class PublicationRr251CountryData {
    attribute groups, PublicationRr251CountryDataGroups
    attribute codelists, PublicationRr251EntryCodelists { cardinality 0..n }
    attribute notes, String { cardinality 0..n }
  }

  class PublicationMetadataLocale {
    attribute key, String
    attribute en, String
    attribute fr, String
    attribute es, String
    attribute ru, String
    attribute zh, String
    attribute ar, String
  }

  class PublicationMetadata {
    attribute title, PublicationMultilingualText
    attribute locale, PublicationMetadataLocale { cardinality 0..n }
    attribute schema, String
  }

  class PublicationCountry {
    attribute key, String
    attribute name, PublicationText
    attribute data, PublicationRr251CountryData
  }

  class PublicationAcronyms {
    attribute de, PublicationText
    attribute bw, PublicationText
    attribute kh, PublicationText
    attribute cn, PublicationText
    attribute cw, PublicationText
    attribute es, PublicationText
    attribute us, PublicationText
    attribute fi, PublicationText
    attribute fr, PublicationText
    attribute ir, PublicationText
    attribute it, PublicationText
    attribute jp, PublicationText
    attribute kg, PublicationText
    attribute kw, PublicationText
    attribute mk, PublicationText
    attribute mu, PublicationText
    attribute false, PublicationText
    attribute pl, PublicationText
    attribute cz, PublicationText
    attribute gb, PublicationText
    attribute si, PublicationText
    attribute ch, PublicationText
    attribute sr, PublicationText
    attribute ve, PublicationText
    attribute zm, PublicationText
  }

  class PublicationDataset {
    attribute dataset, String
    attribute as_of_issue, Integer
    attribute items, Entry { cardinality 0..n }
    attribute metadata, PublicationMetadata
    attribute countries, PublicationCountry { cardinality 0..n }
    attribute acronyms, PublicationAcronyms
  }

  class PublicationDatasets {
    attribute sources, PublicationDataset { cardinality 0..n }
  }
}
