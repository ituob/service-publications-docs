{% when "es" %}{% assign title = "Indicadores de destino (ID) atribuidos a oficinas telegráficas" %}{% assign headers = "País / zona geográfica|Red (administración/EER)|Código de red|Nombre de la oficina telegráfica|Código  de oficina" | split: "|" %}
