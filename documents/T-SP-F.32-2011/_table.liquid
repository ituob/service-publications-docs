{% for country_data in data -%}

{% assign run_start = forloop.index0 %}
{% assign run_size = 0 %}
{% for run_item in data offset: run_start -%}
  {%- if run_item.country_or_area.en == country_data.country_or_area.en -%}
    {%- assign run_size = run_size | plus: 1 -%}
  {%- else -%}
    {%- break -%}
  {%- endif -%}
{%- endfor %}

{% assign next_country = country_data.country_or_area[lang] %}
{% comment %}A trailing "1)" is the printed footnote marker on the country name; it is not part of the name.{% endcomment %}
{% assign country_fr = country_data.country_or_area.fr | strip %}
{% if country_fr.size > 2 and country_fr contains "1)" %}{% assign tail = country_fr | slice: -2, 2 %}{% if tail == "1)" %}{% assign keep = country_fr.size | minus: 2 %}{% assign country_fr = country_fr | slice: 0, keep | strip %}{% endif %}{% endif %}
{% assign country_en = country_data.country_or_area.en | strip %}
{% if country_en.size > 2 and country_en contains "1)" %}{% assign tail = country_en | slice: -2, 2 %}{% if tail == "1)" %}{% assign keep = country_en.size | minus: 2 %}{% assign country_en = country_en | slice: 0, keep | strip %}{% endif %}{% endif %}
{% assign country_es = country_data.country_or_area.es | strip %}
{% if country_es.size > 2 and country_es contains "1)" %}{% assign tail = country_es | slice: -2, 2 %}{% if tail == "1)" %}{% assign keep = country_es.size | minus: 2 %}{% assign country_es = country_es | slice: 0, keep | strip %}{% endif %}{% endif %}
