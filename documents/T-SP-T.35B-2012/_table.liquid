{% comment %}
Labels per language, as the official ITU publication prints them
(T-SP-T.35B-2012-{E,F,S}).
{% endcomment %}
{% case lang %}
    {% when "fr" %}
        {% assign l_admin = "Nom de l’Administration:" %}
        {% assign l_manuf = "Existe t-il, dans votre pays, des fabricants d'équipements conformes aux Recommandations des séries H, T ou V ?" %}
        {% assign l_yes = "OUI" %}
        {% assign l_no = "NON" %}
        {% assign l_authorities = "Autorités responsables de l'attribution" %}
        {% assign l_authority = "Autorité responsable de l'attribution:" %}
        {% assign l_none = "Aucune n'a été désignée" %}
        {% assign l_type = "Type de terminal:" %}
        {% assign l_contact = "Contact:" %}
        {% assign l_org = "Organisation:" %}
        {% assign l_dept = "Département:" %}
        {% assign l_address = "Adresse:" %}
        {% assign l_tel = "Téléphone:" %}
        {% assign l_links = "Liens correspondants:" %}
        {% assign l_updated = "Mise à jour des informations:" %}
        {% assign months = "janvier,février,mars,avril,mai,juin,juillet,août,septembre,octobre,novembre,décembre" | split: "," %}
    {% when "es" %}
        {% assign l_admin = "Nombre de la administración:" %}
        {% assign l_manuf = "¿Existen fabricantes nacionales de equipos conformes a las Series H, T o V?" %}
        {% assign l_yes = "SÍ" %}
        {% assign l_no = "NO" %}
        {% assign l_authorities = "Autoridades de asignación" %}
        {% assign l_authority = "Autoridad de asignación:" %}
        {% assign l_none = "No se ha designado ninguna" %}
        {% assign l_type = "Tipo de terminal:" %}
        {% assign l_contact = "Contacto:" %}
        {% assign l_org = "Organización:" %}
        {% assign l_dept = "Departmento:" %}
        {% assign l_address = "Dirección:" %}
        {% assign l_tel = "Teléfono:" %}
        {% assign l_links = "Enlaces relacionados:" %}
        {% assign l_updated = "Información actualizada:" %}
        {% assign months = "enero,febrero,marzo,abril,mayo,junio,julio,agosto,septiembre,octubre,noviembre,diciembre" | split: "," %}
    {% else %}
        {% assign l_admin = "Name of Administration:" %}
        {% assign l_manuf = "National manufacturers of H-, T- or V-Series compliant equipment?" %}
        {% assign l_yes = "YES" %}
        {% assign l_no = "NO" %}
        {% assign l_authorities = "Assignment authorities" %}
        {% assign l_authority = "Assignment authority:" %}
        {% assign l_none = "None designated" %}
        {% assign l_type = "Terminal Type:" %}
        {% assign l_contact = "Contact name" %}
        {% assign l_org = "Organization:" %}
        {% assign l_dept = "Department:" %}
        {% assign l_address = "Address:" %}
        {% assign l_tel = "Telephone:" %}
        {% assign l_links = "Related links:" %}
        {% assign l_updated = "Information updated:" %}
{% endcase %}


{% case lang %}
    {% when "en" %}
        {% assign us_note = data | where: "country", "iso-3166:us" | map: "note" %}
    {% when "fr" %}
        {% assign us_note = "Les deux organisations sont aussi chargées de l'attribution des codes du prestataire" %}
    {% when "es" %}
        {% assign us_note = "Las dos organizaciones están también encargadas de asignar los códigos de proveedor de terminal UIT-T T.35 para Canada." %}
{% endcase %}

{% for country in data %}

[%unnumbered,cols="2*"]
|===
{% assign country_acronym = country.country | remove: "iso-3166:" | replace: "uk", "gb" %}
2+.<|
{%- if country_acronym != "no" -%}
    {{ acronyms[country_acronym][lang] }}
{%- else -%}
    Norway
{%- endif -%}

| {{ l_admin }} | {{ country.administration_name }}

2+.<| {{ l_manuf }}
{{ country.manufactures_htv | replace: "true", l_yes | replace: "false", l_no }}


{% if country.assignment_authority != "None designated" %}

2+.<|
{% if country.assignment_authority.size > 1 %}
    {{ l_authorities }}
    {%- if country.note -%}
        {%- case lang -%}
            {%- when "en" or "fr" -%}
                footnote:[*Note*: {{ us_note }}]:
            {%- when "es" -%}
                footnote:[*Nota*: {{ us_note }}]:
        {%- endcase -%}
    {%- endif -%}
{% else %}
    {{ l_authority }}{% if country.assignment_authority.size == 0 %} {{ l_none }}{% endif %}
{% endif %}

{% for authority in country.assignment_authority %}

{% for series in authority.terminal_type reversed %}
    {% case forloop.index %}
        {% when 1 %}
            {% assign aux = series | capitalize | remove: "series" %}
            {% assign terminalType = aux | append: "Series" %}

        {% when 2 %}
            {% assign aux = series | capitalize | remove: "series" | append: " and " %}
            {% assign terminalType =  terminalType | prepend: aux %}

        {% when 3 %}
            {% assign aux = series | capitalize | remove: "series" | append: ", " %}
            {% assign terminalType =  terminalType | prepend: aux %}
    {% endcase %}
{% endfor %}

| {{ l_type }} | {{ terminalType }}
| {{ l_contact }} | {{ authority.contact_name }}
| {{ l_org }} | {{ authority.organization }}
| {{ l_dept }} | {{ authority.department }}
| {{ l_address }} | {{ authority.address }}
| {{ l_tel }} | {{ authority.telephone }}
| Fax: | {{ authority.fax }}
| E-mail: | {{ authority.email }}
| {{ l_links }} | {{ authority.related_links }}
{% assign d = authority.last_updated %}{%- capture date_text -%}{%- if lang == "en" -%}{{ d | date: "%d %B %Y" }}{%- else -%}{%- assign mi = d | date: "%-m" | minus: 1 -%}{%- assign ymd = d | date: "%Y-%m-%d" -%}{%- if mi >= 0 and mi < 12 and ymd.size == 10 -%}{{ d | date: "%-d" }}{% if lang == "es" %} de {{ months[mi] }} de {% else %} {{ months[mi] }} {% endif %}{{ d | date: "%Y" }}{%- endif -%}{%- endif -%}{% endcapture %}
| {{ l_updated }} | {{ date_text }}

{% endfor %}

